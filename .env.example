    # Copie para .env e ajuste o que precisar. Todos os valores têm padrão no
# docker-compose.yml, então o projeto sobe sem .env nenhum.
# O .env já está no .gitignore — não comite segredos.

# --- Banco ---------------------------------------------------------------
POSTGRES_DB=db_primevest
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Porta exposta no host. 5433 evita conflito com o PostgreSQL instalado na máquina.
DB_PORT=5433

# --- Portas dos serviços --------------------------------------------------
API_PORT=8080
ADM_API_PORT=8081
WEB_PORT=5173
REDIS_PORT=6379

# --- Segurança ------------------------------------------------------------
# Em produção, gere uma chave própria com no mínimo 256 bits.
JWT_SECRET=primevest-default-secret-key-change-in-production-minimum-256-bits-long

# --- Login pelo Google ----------------------------------------------------
# Um único valor, usado pela api (GOOGLE_CLIENT_ID) e pelo front
# (VITE_GOOGLE_CLIENT_ID) — o docker-compose distribui os dois a partir daqui.
# Deixe VAZIO para desenvolver só com email/senha: o botão do Google some da
# tela de login e o endpoint /auth/google recusa com mensagem clara.
#
# Para obter: console.cloud.google.com -> APIs e Serviços -> Credenciais ->
# Criar credenciais -> ID do cliente OAuth -> Aplicativo da Web. Em "Origens
# JavaScript autorizadas" inclua http://localhost:5173 e http://127.0.0.1:5173.
# NÃO é preciso configurar URI de redirecionamento: o fluxo de ID token não
# redireciona. O client secret gerado junto também não é usado — não o coloque
# neste arquivo.
#
# Este valor não é segredo: ele vai no bundle do front, visível no DevTools.
GOOGLE_CLIENT_ID=

# --- Integrações externas -------------------------------------------------
# Token da BrAPI para cotações da B3 (https://brapi.dev). Vazio = plano gratuito.
BRAPI_TOKEN=

# --- Integrações com corretoras (docs/planos/PLANO_CRIPTO_BINANCE.md) ------------------
# Chave-mestra que cifra (AES-256-GCM) as chaves de API que cada usuário
# cadastra. 32 bytes aleatórios em base64. Gere a sua no PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ou: openssl rand -base64 32
# PERDER esta chave = perder todas as credenciais gravadas (os usuários terão
# de cadastrar de novo). Vazia: a API sobe, mas conexões ficam indisponíveis.
PRIMEVEST_CREDENTIALS_KEY=
# Rotação: gere uma nova, mova a atual para PREVIOUS_KEYS como "1:<base64>" e
# suba a versão. O que foi cifrado com a antiga continua legível.
PRIMEVEST_CREDENTIALS_KEY_VERSION=1
PRIMEVEST_CREDENTIALS_PREVIOUS_KEYS=

# --- Administrador (carga/scripts/admin.mjs) ------------------------------------
# Senha do administrador semeado (V9), para os scripts dispararem as rotinas sem perguntar.
PRIMEVEST_SENHA=

# --- Dados da carga inicial: bucket Cloudflare R2 (docs/planos/PLANO_CARGA_INICIAL.md) --
# A aplicação lê só a pasta carga/data/. Numa máquina nova, baixe o bucket uma vez:
#   docker compose --profile carga run --rm data pull
# s3 = usa o bucket; local = só a carga/data/ como está (sem bucket).
DATA_STORAGE=s3
S3_ENDPOINT=
S3_BUCKET=primevest-data
# Token SÓ LEITURA do R2 (peça a quem mantém o projeto). A chave de escrita fica só com o
# produtor (quem roda o `data push`).
S3_ACCESS_KEY=25501dbe5b73f7e69003815f7e81f778
S3_SECRET_KEY=77d3c0bbc921b7b25a6034734a691dbfb1f332508d57a969834730566e4512c8
