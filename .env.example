    # Copie para .env e ajuste o que precisar. Todos os valores têm padrão no
# docker-compose.yml, então o projeto sobe sem .env nenhum.
# O .env já está no .gitignore — não comite segredos.

# --- Banco ---------------------------------------------------------------
POSTGRES_DB=db_primevest
DB_USERNAME=postgres
DB_PASSWORD=postgres
# Porta exposta no host. 5433 evita conflito com o PostgreSQL instalado na máquina.
DB_PORT=5433

# --- Portas dos serviços --------------------------------------------------
API_PORT=8080
ADM_API_PORT=8081
WEB_PORT=5173
REDIS_PORT=6379

# --- Segurança ------------------------------------------------------------
# Em produção, gere uma chave própria com no mínimo 256 bits.
JWT_SECRET=primevest-default-secret-key-change-in-production-minimum-256-bits-long

# --- Login pelo Google ----------------------------------------------------
# Um único valor, usado pela api (GOOGLE_CLIENT_ID) e pelo front
# (VITE_GOOGLE_CLIENT_ID) — o docker-compose distribui os dois a partir daqui.
# Deixe VAZIO para desenvolver só com email/senha: o botão do Google some da
# tela de login e o endpoint /auth/google recusa com mensagem clara.
#
# Para obter: passo a passo em docs/planos/PLANO_CADASTRO_USUARIO.md, apêndice A
# (Google Auth Platform -> Clients -> Aplicativo da Web). Origens JavaScript autorizadas:
# http://localhost e http://localhost:5173 (o Google exige as duas). Nenhuma URI de
# redirecionamento: o fluxo de ID token não redireciona. O client secret gerado junto
# também não é usado — não o coloque neste arquivo. Custo: nenhum.
#
# Este valor não é segredo: ele vai no bundle do front, visível no DevTools.
GOOGLE_CLIENT_ID=

# --- Cadastro de usuário (docs/planos/PLANO_CADASTRO_USUARIO.md) -------------
# false = ninguém cria conta, nem pelo Google (o link "Criar conta" some). No DEV local: true.
SIGNUP_ENABLED=false
# HMAC dos códigos de verificação e do CPF (unicidade sem decifrar). Gere uma vez e não troque:
# trocar faz a unicidade do CPF deixar de enxergar os já gravados. Vazio = usa o JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PRIMEVEST_HASH_KEY=

# --- E-mail (códigos de cadastro, senha, troca de e-mail) --------------------
# Vazio = Mailpit do compose: nada sai da máquina, a caixa fica em http://localhost:8025.
# SMTP real (ex.: Gmail com senha de app): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME, MAIL_PASSWORD, MAIL_SMTP_AUTH=true, MAIL_SMTP_STARTTLS=true.
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=
MAIL_SMTP_STARTTLS=
MAIL_FROM=PrimeVest <nao-responda@primevest.local>
# Portas do Mailpit no host
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025
# Endereço do front, citado no rodapé dos e-mails
APP_URL=http://localhost:5173

# --- Integrações externas -------------------------------------------------
# Token da BrAPI para cotações da B3 (https://brapi.dev). Vazio = plano gratuito.
BRAPI_TOKEN=

# --- Integrações com corretoras (docs/planos/PLANO_CRIPTO_BINANCE.md) ------------------
# Chave-mestra que cifra (AES-256-GCM) as chaves de API que cada usuário
# cadastra. 32 bytes aleatórios em base64. Gere a sua no PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# ou: openssl rand -base64 32
# PERDER esta chave = perder todas as credenciais gravadas (os usuários terão
# de cadastrar de novo). Vazia: a API sobe, mas conexões ficam indisponíveis.
PRIMEVEST_CREDENTIALS_KEY=
# Rotação: gere uma nova, mova a atual para PREVIOUS_KEYS como "1:<base64>" e
# suba a versão. O que foi cifrado com a antiga continua legível.
PRIMEVEST_CREDENTIALS_KEY_VERSION=1
PRIMEVEST_CREDENTIALS_PREVIOUS_KEYS=

# --- Área do Investidor da B3 (docs/planos/PLANO_INTEGRACAO_B3.md, 6.13) ---------------------------
# Sem B3I_ENABLED=true a B3 não aparece entre as fontes. Credenciais e certificado são do PrimeVest
# (Pacote de Acesso, contrato com a B3); o CPF de cada investidor fica cifrado no banco.
#   B3 real:    B3I_BASE_URL=https://investidor.b3.com.br:2443 (certificação: https://apib3i-cert.b3.com.br:2443)
#               B3I_TOKEN_URL=https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token
#               B3I_OPTIN_URL = o conteúdo do Link_optin.txt
#   Simulador:  docker compose --profile b3mock up -d b3-investidor-mock, com os valores abaixo
B3I_ENABLED=false
B3I_BASE_URL=http://b3-investidor-mock:8090
B3I_TOKEN_URL=http://b3-investidor-mock:8090/simulador/oauth2/v2.0/token
B3I_CLIENT_ID=primevest-teste
B3I_CLIENT_SECRET=segredo-teste
B3I_SCOPE=b3i-simulador/.default
# Certificado .p12 do Pacote de Acesso (mTLS), caminho dentro do contêiner da app-api; vazio = sem mTLS.
B3I_CERT_P12_PATH=
B3I_CERT_P12_PASSWORD=
# Página onde o investidor autoriza o PrimeVest (aberta no navegador).
B3I_OPTIN_URL=http://localhost:8090/optin
# Uma consulta por CPF por dia (regra da B3). false só no simulador, para testar a segunda sincronização.
B3I_ONCE_PER_DAY=true
# Simulador: porta, pasta dos extratos exportados (fora do git) e CPF fictício válido que ele atende.
# B3I_MOCK_AUTHORIZED=true começa com o PrimeVest já autorizado.
B3I_MOCK_PORT=8090
B3I_MOCK_DATA_DIR=./carga/mocks
B3I_MOCK_DOCUMENT=52998224725
B3I_MOCK_AUTHORIZED=false

# --- Administrador (carga/scripts/admin.mjs) ------------------------------------
# Senha do administrador semeado (V9), para os scripts dispararem as rotinas sem perguntar.
PRIMEVEST_SENHA=

# --- Dados da carga inicial: bucket Cloudflare R2 (docs/planos/PLANO_CARGA_INICIAL.md) --
# A aplicação lê só a pasta carga/data/. Numa máquina nova, baixe o bucket uma vez:
#   docker compose --profile carga run --rm data pull
# s3 = usa o bucket; local = só a carga/data/ como está (sem bucket).
DATA_STORAGE=s3
S3_ENDPOINT=https://7075601d46a2893547992340c615da43.r2.cloudflarestorage.com
S3_BUCKET=primevest-data
# Token SÓ LEITURA do R2 (peça a quem mantém o projeto). A chave de escrita fica só com o
# produtor (quem roda o `data push`).
S3_ACCESS_KEY=
S3_SECRET_KEY=
