<?xml version="1.0" encoding="UTF-8"?>
<!--
    Agregador do backend (PLANO_ADM_API.md).

      primevest-core     modelo JPA, repositorios, regras de posicao e proventos, migrations,
                         validacao do JWT e tratamento de erro — biblioteca, sem main
      primevest-adm-api  rotinas de administrador: catalogo (porta 8081)
      primevest-app-api  a API do usuario, a carteira (porta 8080)

    Versoes, compilador e testes ficam aqui; cada modulo declara so as suas dependencias.
    Rodar da raiz: mvn clean verify (todos) ou mvn -pl primevest-app-api -am verify (um so).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.primevest</groupId>
    <artifactId>primevest-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>PrimeVest</name>
    <description>PrimeVest - Disciplina leva à liberdade. Investment Portfolio Management System.</description>

    <modules>
        <module>primevest-core</module>
        <module>primevest-adm-api</module>
        <module>primevest-app-api</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>2.6.0</springdoc.version>
        <!--
            Acima da versao que o Spring Boot 3.3.5 gerencia (1.19.8): o Docker
            Engine 29 recusa as versoes antigas da API que o docker-java daquela
            linha usa, e o Testcontainers respondia "Could not find a valid
            Docker environment" com o Docker Desktop rodando normalmente.
        -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!--
            spring-boot:run roda da raiz com -pl <modulo> -am -Drun.module=<modulo> (dev-watch.sh):
            so o modulo escolhido religa (perfil run dele); agregador, core e o resto passam direto.
        -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.primevest</groupId>
                <artifactId>primevest-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.primevest</groupId>
                <artifactId>primevest-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.primevest</groupId>
                <artifactId>primevest-adm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.primevest</groupId>
                <artifactId>primevest-adm-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                *Test -> Surefire (mvn test): repositório, serviço e controller.
                *IT   -> Failsafe (mvn verify): funcionais, com a aplicação inteira.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
